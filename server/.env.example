# ─── App ──────────────────────────────────────────────
NODE_ENV=development
# Port the API listens on
PORT=5000
# Frontend origin (used for CORS and links in emails). Comma-separate several origins.
CLIENT_URL=http://localhost:3000
# Public URL of this API (used to build URLs for locally stored uploads)
SERVER_URL=http://localhost:5000
# Public storefront URL used in sitemap.xml, canonical links and emails
SITE_URL=http://localhost:3000

# ─── Database ─────────────────────────────────────────
# MongoDB Atlas: Connect → Drivers. Include the database name (/wildtane) before the "?".
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/wildtane?retryWrites=true&w=majority

# ─── Auth ─────────────────────────────────────────────
# Long random string. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d
# Name of the HTTP-only auth cookie
COOKIE_NAME=wt_token

# ─── First admin (created by `npm run seed`) ─────────
ADMIN_NAME=Wildtane Admin
ADMIN_EMAIL=admin@wildtane.com
ADMIN_PASSWORD=change-this-password

# ─── Cloudinary (optional) ────────────────────────────
# Leave blank to store uploads in server/uploads instead.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=wildtane

# ─── WhatsApp Cloud API (optional) ────────────────────
# From Meta for Developers → WhatsApp → API Setup. Leave blank to log notifications instead.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0
# Admin number that receives new-order alerts, digits with country code, e.g. 919876543210
ADMIN_WHATSAPP_NUMBER=
# Optional approved template for the Tax Invoice PDF: header = Document, body with {{1}} name, {{2}} order id, {{3}} amount.
# Without it the PDF is sent as a plain document, which WhatsApp only delivers within 24 h of the customer's last message.
WHATSAPP_INVOICE_TEMPLATE=
WHATSAPP_TEMPLATE_LANG=en

# ─── Email: password resets and order updates (optional) ───
# Blank → emails are printed to the server console (in development the reset link is also shown on the page).
# Any SMTP provider works (Gmail app password, Brevo, Amazon SES, Zoho, Mailgun…). Test with `npm run test:email`.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=WILDTANE <no-reply@wildtane.com>

# Proxies in front of the API, so rate limits see each visitor's real IP.
# Railway alone: 1. Netlify forwarding /api to Railway (netlify.toml): 2.
TRUST_PROXY=1

# ── Free AI for "Write with AI" when adding products (optional) ──
# Get a free key (no card) at https://aistudio.google.com/apikey and paste it here.
GEMINI_API_KEY=
# Lite is fast and reliable on the free tier; gemini-flash-latest writes a bit better but is often busy.
# GEMINI_MODEL=gemini-flash-lite-latest
